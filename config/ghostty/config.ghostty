font-family = FiraCode Nerd Font
font-size = 14
font-thicken = true
adjust-cell-height = 10%
background = 282828
foreground = ebdbb2
background-opacity = 0.87
background-blur = 9
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
scrollback-limit = 10000000
cursor-style = block
cursor-style-blink = false
macos-option-as-alt = left
window-save-state = always
confirm-close-surface = false

palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

keybind = ctrl+alt+super+shift+a=text:\x01
